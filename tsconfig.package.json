{
  "compilerOptions": {
    "target": "ES2022",
    // No DOM. The published surface is pure by contract, so a stray reference
    // to `document` or `indexedDB` should fail this build rather than ship.
    "lib": ["ES2022"],
    "types": [],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  // Only the entry points. Everything the package publishes is reachable from
  // one of these, and anything that is not reachable is not part of the package.
  "files": [
    "src/index.ts",
    "src/fields.ts",
    "src/calibration.ts",
    "src/presets.ts",
    "src/web.ts"
  ]
}
