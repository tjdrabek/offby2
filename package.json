{
  "name": "offby2",
  "version": "0.0.0",
  "description": "Sheet layouts for label printing: read what an operator entered, derive the values they left out, and refuse geometry that cannot exist.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["lib"],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./fields": {
      "types": "./lib/fields.d.ts",
      "default": "./lib/fields.js"
    },
    "./calibration": {
      "types": "./lib/calibration.d.ts",
      "default": "./lib/calibration.js"
    },
    "./presets": {
      "types": "./lib/presets.d.ts",
      "default": "./lib/presets.js"
    },
    "./web": {
      "types": "./lib/web.d.ts",
      "default": "./lib/web.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npm run build:package",
    "clean:package": "node -e \"require('fs').rmSync('lib',{recursive:true,force:true})\"",
    "build:package": "npm run clean:package && tsc -p tsconfig.package.json",
    "watch:package": "tsc -p tsconfig.package.json --watch",
    "prepublishOnly": "npm run build:package && npm test",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
